# このファイルをコピーして .env.local を作成し、実際の値を入力してください。
# .env.local はGitには含まれません(.gitignoreで除外済み)。
#
# 値の取得方法は OPERATIONS.md「8. 開発者向け情報」を参照してください。
# Sanityプロジェクトの作成には、クラブの管理用Googleアカウントでのログインが必要です(OPERATIONS.md参照)。

# Sanityの管理画面(sanity.io)でプロジェクト作成後に確認できるID
NEXT_PUBLIC_SANITY_PROJECT_ID=

# 通常は production のままで問題ありません
NEXT_PUBLIC_SANITY_DATASET=production

# APIバージョン。日付形式で固定し、意図せず動作が変わらないようにする
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01

# 下書きプレビューなど、書き込み系の機能を使う場合のみ必要(現時点では未使用)
# SANITY_API_TOKEN=
